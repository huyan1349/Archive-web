{
  "manifest_version": 3,
  "name": "LUCERNA · 微信读书导入",
  "version": "1.1",
  "description": "一键将微信读书的划线、笔记同步到 LUCERNA",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "webRequest",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://weread.qq.com/*",
    "https://i.weread.qq.com/*",
    "http://localhost:5177/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5177/*"],
      "js": ["lucerna-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://weread.qq.com/*"],
      "js": ["weread-content.js"],
      "run_at": "document_idle"
    }
  ]
}
